<UserControl x:Class="PosApp.Desktop.Views.DCRView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PosApp.Desktop.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#1e1e1e" VerticalAlignment="Center" HorizontalAlignment="Center">
        <Border Background="#2d2d2d" Padding="40" CornerRadius="12" BorderBrush="#333333" BorderThickness="1">
            <StackPanel Width="300">
                <TextBlock Text="DAILY CASH REPORT" Foreground="#ff8c00" FontSize="20" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="Generate summary of today's sales and physical cash count." Foreground="#888888" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,30"/>
                
                <Button Content="OPEN DENOMINATIONS &amp; PRINT" 
                        Command="{Binding OpenDcrCommand}"
                        Height="55" Background="#ff8c00" Foreground="White" FontWeight="Bold" FontSize="14" BorderThickness="0" Margin="0,0,0,10">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="REPRINT BY DATE" 
                        Command="{Binding PrintByDateCommand}"
                        Height="45" Background="#333333" Foreground="Cyan" FontWeight="Bold" FontSize="13" BorderThickness="1" BorderBrush="Cyan" Margin="0,0,0,10">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="BACK TO SALE" 
                        Command="{Binding CloseCommand}"
                        Height="45" Background="#444444" Foreground="White" FontWeight="Bold" FontSize="13" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <TextBlock Text="Note: This will capture all sales for the current session." Foreground="#555555" FontSize="10" TextAlignment="Center" Margin="0,20,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
