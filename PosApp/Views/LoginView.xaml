<UserControl x:Class="PosApp.Desktop.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1280"
             UseLayoutRounding="True" 
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">
    <Grid>
        <!-- Background with a professional dark gradient -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0a0a0b" Offset="0"/>
                <GradientStop Color="#141416" Offset="0.5"/>
                <GradientStop Color="#050506" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Decorative elements for glassmorphism feel -->
        <Ellipse Width="600" Height="600" Fill="#ff8c00" Opacity="0.04" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-200,-200,0">
            <Ellipse.Effect>
                <BlurEffect Radius="150"/>
            </Ellipse.Effect>
        </Ellipse>
        <Ellipse Width="400" Height="400" Fill="#ff8c00" Opacity="0.02" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-100,0,0,-100">
            <Ellipse.Effect>
                <BlurEffect Radius="120"/>
            </Ellipse.Effect>
        </Ellipse>

        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False">
            <Border Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40" 
                    Background="#1e1e1f" BorderBrush="#333335" BorderThickness="1" Padding="40" CornerRadius="16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="60" Color="Black" ShadowDepth="0" Opacity="0.8"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Counter Badge -->
                    <Border Background="#252526" CornerRadius="12" Padding="12,4" HorizontalAlignment="Center" Margin="0,0,0,30" BorderBrush="#333335" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="#ff8c00" Margin="0,0,8,0"/>
                            <TextBlock Foreground="#88888a" FontSize="10" FontWeight="Bold" VerticalAlignment="Center">
                                <Run Text="TERMINAL ID: "/>
                                <Run Text="{Binding Settings.CounterNo, StringFormat='C{0:D2}'}" Foreground="#ff8c00"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Logo/Branding Section -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                        <TextBlock Text="ASIF" Foreground="#ff8c00" FontSize="38" FontWeight="Black"/>
                    </StackPanel>
                    <TextBlock Text="SUPER STORE POS" Foreground="#666668" FontSize="12" FontWeight="Bold" 
                               HorizontalAlignment="Center" Margin="0,0,0,40" TextAlignment="Center"/>
                    
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="USERNAME" Foreground="#88888a" Margin="4,0,0,8" FontSize="10" FontWeight="Black" TextAlignment="Left"/>
                        <TextBox x:Name="UsernameBox" KeyDown="OnKeyDown" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                                 Padding="16,12" Background="#141415" Foreground="White" Height="48" FontSize="15"
                                 BorderThickness="1" BorderBrush="#333335" VerticalContentAlignment="Center" CaretBrush="#ff8c00">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </TextBox.Resources>
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <Trigger Property="IsFocused" Value="True">
                                            <Setter Property="BorderBrush" Value="#ff8c00"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,40">
                        <TextBlock Text="PASSWORD" Foreground="#88888a" Margin="4,0,0,8" FontSize="10" FontWeight="Black" TextAlignment="Left"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <PasswordBox x:Name="UserPasswordBox" KeyDown="OnKeyDown" PasswordChanged="PasswordBox_PasswordChanged" 
                                         Padding="16,12,50,12" Background="#141415" Foreground="White" Height="48" FontSize="15"
                                         BorderThickness="1" BorderBrush="#333335" VerticalContentAlignment="Center" CaretBrush="#ff8c00">
                                <PasswordBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </PasswordBox.Resources>
                            </PasswordBox>
                            
                            <TextBox x:Name="VisiblePasswordBox" Visibility="Collapsed" IsReadOnly="True"
                                     Padding="16,12,50,12" Background="#141415" Foreground="White" Height="48" FontSize="15"
                                     BorderThickness="1" BorderBrush="#333335" VerticalContentAlignment="Center" CaretBrush="#ff8c00">
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>

                            <Button Grid.Column="1" Width="48" Height="48" Background="Transparent" BorderThickness="0"
                                    PreviewMouseDown="ShowPassword_MouseDown" PreviewMouseUp="ShowPassword_MouseUp" Cursor="Hand"
                                    Margin="-48,0,0,0">
                                <TextBlock Text="👁" Foreground="#444446" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <Button Content="LOG IN" Command="{Binding LoginCommand}" Height="52" FontSize="15"
                            Foreground="White" FontWeight="Black" Padding="15" BorderThickness="0" Cursor="Hand"
                            FocusVisualStyle="{x:Null}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#ff8c00"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#ffa033"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#e67e00"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <TextBlock Text="{Binding StatusText}" Foreground="#ff5555" HorizontalAlignment="Center" Margin="0,25,0,0" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </ScrollViewer>
        
        <!-- Footer Info -->
        <TextBlock Text="SYSTEM VERSION 2.0 • PROFESSIONAL RETAIL SOLUTION" 
                   Foreground="#333335" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,25" FontSize="10" FontWeight="Bold"/>
    </Grid>
</UserControl>
