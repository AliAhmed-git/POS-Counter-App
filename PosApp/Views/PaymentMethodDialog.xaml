<Window x:Class="PosApp.Desktop.Views.PaymentMethodDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Payment Method" Height="580" Width="750"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1e1e1e" Foreground="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="CHOOSE PAYMENT METHOD" FontSize="24" FontWeight="Bold" Foreground="#ff8c00" HorizontalAlignment="Center" Margin="0,0,0,10"/>
        
        <!-- Total Amount Display -->
        <Border Grid.Row="1" Background="#252526" CornerRadius="8" Padding="20,15" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="AMOUNT TO PAY" Foreground="#888888" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding TotalAmount, StringFormat='₨ {0:N0}'}" Foreground="#ff8c00" FontSize="32" FontWeight="Black" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="MethodsList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Click="Method_Click" Width="210" Height="130" Margin="8" Background="#2d2d2d" BorderThickness="1" BorderBrush="#444444">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10">
                                            <!-- Logo Image -->
                                            <Image Source="{Binding LogoPath}" Width="70" Height="70" Margin="0,0,0,8" Stretch="Uniform">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LogoPath}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                            <TextBlock Text="{Binding Method}" HorizontalAlignment="Center" FontSize="14" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" TextAlignment="Center"/>
                                            <TextBlock Text="{Binding ChargePercentage, StringFormat='{}{0}% Fee'}" HorizontalAlignment="Center" FontSize="11" Foreground="#888888" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#3d3d3d"/>
                                            <Setter Property="BorderBrush" Value="#ff8c00"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="3" Content="CANCEL" Click="Cancel_Click" Width="120" Height="40" Margin="0,20,0,0" HorizontalAlignment="Right" Background="#333333" Foreground="White" BorderThickness="0">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="6"/>
                </Style>
            </Button.Resources>
        </Button>
    </Grid>
</Window>
