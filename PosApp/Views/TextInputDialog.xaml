<Window x:Class="PosApp.Desktop.Views.TextInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Input" Height="200" Width="350"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#1e1e1e" BorderBrush="#ff8c00" BorderThickness="1">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptTextBlock" Text="ENTER VALUE" Foreground="#ff8c00" 
                   FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

        <TextBox x:Name="InputTextBox" Grid.Row="1" 
                  FontSize="24" Padding="10" 
                  Background="#2d2d2d" Foreground="White" 
                  BorderBrush="#444444" BorderThickness="1"
                  VerticalAlignment="Center" HorizontalContentAlignment="Center"
                  KeyDown="InputTextBox_KeyDown">
            <TextBox.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="4"/>
                </Style>
            </TextBox.Resources>
        </TextBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="CANCEL (Esc)" Click="Cancel_Click" 
                    Padding="15,8" Margin="0,0,10,0" 
                    Background="#333333" Foreground="#888888" BorderThickness="0"/>
            <Button Content="OK (Enter)" Click="OK_Click" 
                    Padding="20,8" 
                    Background="#ff8c00" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
