<UserControl x:Class="PosApp.Desktop.Views.SaleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PosApp.Desktop.Views"
             xmlns:vm="clr-namespace:PosApp.Desktop.ViewModels"
             xmlns:conv="clr-namespace:PosApp.Desktop.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1280">
    <UserControl.Resources>
        <conv:IntToBoolConverter x:Key="IntToBoolConverter"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:BoolToLockIconConverter x:Key="BoolToLockIconConverter"/>
        <local:BoolToColorConverter x:Key="BoolToColorConverter"/>
        <Style x:Key="ModernScrollBar" TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="6"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid x:Name="Bg" Background="{TemplateBinding Background}">
                                    <Track x:Name="PART_Track" IsDirectionReversed="true" IsEnabled="{TemplateBinding IsEnabled}">
                                        <Track.Thumb>
                                            <Thumb x:Name="Thumb">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border x:Name="ThumbBorder" Background="#444444" CornerRadius="3" Opacity="0.5"/>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="true">
                                                                <Setter TargetName="ThumbBorder" Property="Background" Value="#ff8c00"/>
                                                                <Setter TargetName="ThumbBorder" Property="Opacity" Value="1"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="6"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid x:Name="Bg" Background="{TemplateBinding Background}">
                                    <Track x:Name="PART_Track" IsDirectionReversed="false" IsEnabled="{TemplateBinding IsEnabled}">
                                        <Track.Thumb>
                                            <Thumb x:Name="Thumb">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border x:Name="ThumbBorder" Background="#444444" CornerRadius="3" Opacity="0.5"/>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="true">
                                                                <Setter TargetName="ThumbBorder" Property="Background" Value="#ff8c00"/>
                                                                <Setter TargetName="ThumbBorder" Property="Opacity" Value="1"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    
    <UserControl.InputBindings>
        <KeyBinding Key="F12" Command="{Binding PrintReceiptCommand}"/>
        <KeyBinding Key="F8" Command="{Binding PrintLastReceiptCommand}"/>
        <KeyBinding Key="F6" Command="{Binding PrintTestBarcodesCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding RemoveItemCommand}" CommandParameter="{Binding SelectedItem, ElementName=SaleGrid}"/>
        <KeyBinding Modifiers="Control" Key="A" Command="{Binding SelectAllItemsCommand}"/>
        <KeyBinding Modifiers="Control" Key="D" Command="{Binding DuplicateItemCommand}" CommandParameter="{Binding SelectedItems, ElementName=SaleGrid}"/>
        <KeyBinding Modifiers="Control" Key="C" Command="{Binding CopyItemsCommand}" CommandParameter="{Binding SelectedItems, ElementName=SaleGrid}"/>
        <KeyBinding Modifiers="Control" Key="V" Command="{Binding PasteItemsCommand}"/>
    </UserControl.InputBindings>

    <Grid Background="#1e1e1e" PreviewKeyDown="SaleView_PreviewKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Bar: Header & Barcode Entry -->
        <Border Grid.Row="0" Background="#252526" Padding="25,15" BorderBrush="#3d3d3d" BorderThickness="0,0,0,1">
            <DockPanel>
                <!-- Hints removed as per user request -->
                
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,40,0">
                    <TextBlock Text="INVOICE" Foreground="#666666" FontSize="10" FontWeight="Bold" VerticalAlignment="Bottom" Margin="0,0,8,4"/>
                    <TextBlock Text="{Binding NextInvoiceNo}" Foreground="#ff8c00" FontSize="24" FontWeight="Black" VerticalAlignment="Center"/>
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Multiplier Input -->
                    <TextBox x:Name="MultiplierBox" Text="{Binding QuantityMultiplier, StringFormat='{}{0:0.###}', UpdateSourceTrigger=PropertyChanged}"
                             Width="60" FontSize="20" Padding="10" Background="#1a1a1a" Foreground="Cyan" 
                             BorderThickness="1,1,0,1" BorderBrush="#333333" CaretBrush="White"
                             VerticalContentAlignment="Center" Margin="0,0,0,0"
                             PreviewTextInput="NumberValidationTextBox">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8,0,0,8"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>

                    <!-- Multiplier Lock Button -->
                    <Button Grid.Column="1" Command="{Binding ToggleMultiplierLockCommand}" 
                            Width="32" Height="32" Background="#1a1a1a" BorderBrush="#333333" 
                            BorderThickness="1,1,0,1" Padding="0" Margin="0" ToolTip="Lock/Unlock Multiplier">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" 
                                   Foreground="{Binding IsMultiplierLocked, Converter={StaticResource BoolToColorConverter}}">
                            <TextBlock.Text>
                                <Binding Path="IsMultiplierLocked">
                                    <Binding.Converter>
                                        <local:BoolToLockIconConverter/>
                                    </Binding.Converter>
                                </Binding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Button>

                    <TextBox x:Name="BarcodeBox" Grid.Column="2" Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}" 
                             FontSize="20" Padding="15,10,40,10" Background="#1a1a1a" Foreground="#ff8c00" 
                             BorderThickness="1" BorderBrush="#333333" CaretBrush="White"
                             VerticalContentAlignment="Center"
                             PreviewKeyDown="BarcodeBox_PreviewKeyDown">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="0,8,8,0"/>
                            </Style>
                        </TextBox.Resources>
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding ProcessBarcodeCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>

                    <!-- Clear Button removed as per user request -->
                    
                    <!-- Search Suggestions Popup -->
                    <Popup IsOpen="{Binding HasSearchResults, Mode=OneWay}" 
                           PlacementTarget="{Binding ElementName=BarcodeBox}" 
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                        <Border Background="#2d2d2d" BorderBrush="#ff8c00" BorderThickness="1" Width="{Binding ActualWidth, ElementName=BarcodeBox}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ListBox x:Name="ResultsList" ItemsSource="{Binding SearchResults}" 
                                         SelectedIndex="{Binding SearchSelectedIndex}"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="White" MaxHeight="400"
                                         VirtualizingStackPanel.IsVirtualizing="True"
                                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                                         ScrollViewer.IsDeferredScrollingEnabled="True">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.Resources>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#ff8c00"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#3d3d3d"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black"/>
                                        
                                        <!-- Modern Scrollbar Style -->
                                         <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernScrollBar}"/>
                                    </ListBox.Resources>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.SelectProductCommand, ElementName=BarcodeBox}"
                                                    CommandParameter="{Binding}"
                                                    BorderThickness="0" 
                                                    HorizontalContentAlignment="Stretch" Padding="10" Cursor="Hand"
                                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}">
                                                                        <ContentPresenter/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                                <Grid Background="Transparent">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                     <StackPanel IsHitTestVisible="False">
                                                         <StackPanel Orientation="Horizontal">
                                                             <TextBlock Text="{Binding ItemName}" FontWeight="Bold" FontSize="14" Foreground="White" Width="260" TextTrimming="CharacterEllipsis"/>
                                                             <TextBlock Text="▼" Foreground="#ff8c00" Margin="8,0,0,0" 
                                                                        Visibility="{Binding HasMultiplePackings, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                        FontSize="10" VerticalAlignment="Center"/>
                                                         </StackPanel>
                                                         <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                             <TextBlock Text="{Binding Company}" Foreground="#888888" FontSize="11" MaxWidth="100" TextTrimming="CharacterEllipsis"/>
                                                             <TextBlock Text=" • " Foreground="#444444" FontSize="11" Visibility="{Binding Group, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}"/>
                                                             <TextBlock Text="{Binding Group}" Foreground="#ff8c00" FontSize="11" Opacity="0.8" MaxWidth="80" TextTrimming="CharacterEllipsis"/>
                                                             <TextBlock Text=" • " Foreground="#444444" FontSize="11"/>
                                                             <TextBlock Text="{Binding Packing}" Foreground="Cyan" FontSize="11" FontWeight="SemiBold"/>
                                                             <TextBlock Text="{Binding PackQty, StringFormat=' ({0})'}" Foreground="#888888" FontSize="10">
                                                                 <TextBlock.Style>
                                                                     <Style TargetType="TextBlock">
                                                                         <Setter Property="Visibility" Value="Visible"/>
                                                                         <Style.Triggers>
                                                                             <DataTrigger Binding="{Binding PackQty}" Value="0">
                                                                                 <Setter Property="Visibility" Value="Collapsed"/>
                                                                             </DataTrigger>
                                                                             <DataTrigger Binding="{Binding PackQty}" Value="1">
                                                                                 <Setter Property="Visibility" Value="Collapsed"/>
                                                                             </DataTrigger>
                                                                         </Style.Triggers>
                                                                     </Style>
                                                                 </TextBlock.Style>
                                                             </TextBlock>
                                                         </StackPanel>
                                                     </StackPanel>
                                                     
                                                     <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                                         <TextBlock Text="RS." Foreground="#888888" FontSize="10" HorizontalAlignment="Right"/>
                                                         <TextBlock Text="{Binding SPrice, StringFormat='N0'}" Foreground="#ff8c00" FontSize="20" FontWeight="Black" HorizontalAlignment="Right"/>
                                                     </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            <Setter Property="BorderBrush" Value="#333333"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#3d3d3d"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#ff8c00"/>
                                                    <Setter Property="Foreground" Value="Black"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding SelectProductCommand}" CommandParameter="{Binding SelectedItem, ElementName=ResultsList}"/>
                                    </ListBox.InputBindings>
                                </ListBox>
                                <TextBlock Grid.Row="1" Text="{Binding SearchSummary}" 
                                           Foreground="#888888" FontSize="11" Margin="10,5" 
                                           HorizontalAlignment="Center" FontStyle="Italic"/>
                            </Grid>
                        </Border>
                    </Popup>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Main Items Grid -->
        <DataGrid x:Name="SaleGrid" Grid.Row="1" ItemsSource="{Binding SaleItems}" AutoGenerateColumns="False" 
                  Background="Transparent" BorderThickness="0" CanUserAddRows="False"
                  RowHeight="32" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#333333" 
                  Foreground="White" HeadersVisibility="Column" SelectionMode="Extended"
                  ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ClipboardCopyMode="None" Tag="{Binding}">
            <DataGrid.ContextMenu>
                <ContextMenu Background="#2d2d2d" Foreground="White" BorderThickness="1" BorderBrush="#ff8c00">
                    <MenuItem Header="Merge Quantity" 
                              Command="{Binding PlacementTarget.Tag.MergeItemsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              Background="Transparent" Foreground="Cyan"/>
                    <Separator Background="#444444"/>
                    <MenuItem Header="Duplicate Selected" 
                              Command="{Binding PlacementTarget.Tag.DuplicateItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              Background="Transparent" Foreground="White"/>
                    <Separator Background="#444444"/>
                    <MenuItem Header="Remove Selected" 
                              Command="{Binding PlacementTarget.Tag.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              Background="Transparent" Foreground="#ff6666"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#3d3d3d"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#252525"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#ff8c00"/>

                <!-- Use the modern scrollbar for the items grid as well -->
                <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernScrollBar}"/>

                <Style x:Key="CenteredCell" TargetType="TextBlock">
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="TextAlignment" Value="Center"/>
                </Style>

                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#252526"/>
                    <Setter Property="Foreground" Value="#aaaaaa"/>
                    <Setter Property="Padding" Value="10,12"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="BorderBrush" Value="#333333"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="#1e1e1e"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="BorderBrush" Value="#2d2d2d"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFlash}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetProperty="(Background).(SolidColorBrush.Color)" 
                                                         From="#ff8c00" To="#1e1e1e" Duration="0:0:0.8"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#252525"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#3d3d3d"/>
                            <Setter Property="Foreground" Value="#ff8c00"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
                <!-- Default DataGridCell Style -->
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="10,0"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#3d3d3d"/>
                            <Setter Property="Foreground" Value="#ff8c00"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Company" Binding="{Binding Company}" Width="120" IsReadOnly="True" Foreground="#cccccc"/>
                <DataGridTemplateColumn Width="*">
                    <DataGridTemplateColumn.Header>
                        <!-- Using a Grid for robust alignment: Name on left, X on far right -->
                        <Grid HorizontalAlignment="Stretch">
                            <TextBlock Text="Item Name" VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="#aaaaaa"/>
                        </Grid>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ItemName}" VerticalAlignment="Center" FontSize="14" Margin="10,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Packing" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                <!-- Simple Text for single packing -->
                                <TextBlock Text="{Binding Packing}" Foreground="White" 
                                           VerticalAlignment="Center" Margin="5,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasMultiplePackings}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Dropdown for multiple packings -->
                                <ComboBox ItemsSource="{Binding AvailablePackings}" 
                                          SelectedItem="{Binding SelectedPacking, UpdateSourceTrigger=PropertyChanged}"
                                          DisplayMemberPath="PackingType"
                                          VerticalAlignment="Center" HorizontalAlignment="Stretch" Height="26">
                                    <ComboBox.Style>
                                        <Style TargetType="ComboBox">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Setter Property="Background" Value="#3d3d3d"/>
                                            <Setter Property="Foreground" Value="#ff8c00"/>
                                            <Setter Property="BorderBrush" Value="#555555"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Padding" Value="5,0"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ComboBox">
                                                        <Grid>
                                                            <ToggleButton x:Name="ToggleButton" 
                                                                        Background="{TemplateBinding Background}" 
                                                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                                                        BorderThickness="{TemplateBinding BorderThickness}" 
                                                                        IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                                                        Grid.ColumnSpan="2">
                                                                <ToggleButton.Template>
                                                                    <ControlTemplate TargetType="ToggleButton">
                                                                        <Border Background="{TemplateBinding Background}" 
                                                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                                                BorderThickness="{TemplateBinding BorderThickness}" 
                                                                                CornerRadius="2">
                                                                            <Grid HorizontalAlignment="Right" Width="18">
                                                                                <Path x:Name="Arrow" Fill="#ff8c00" Data="M 0 0 L 3.5 4 L 7 0 Z" 
                                                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            </Grid>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </ToggleButton.Template>
                                                            </ToggleButton>
                                                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" 
                                                                            Content="{TemplateBinding SelectionBoxItem}" 
                                                                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                                                            ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                                                            Margin="5,0,23,0" VerticalAlignment="Center"/>
                                                            <Popup x:Name="Popup" Placement="Bottom" 
                                                                   IsOpen="{TemplateBinding IsDropDownOpen}" 
                                                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                                                <Grid x:Name="DropDown" SnapsToDevicePixels="True" 
                                                                      MinWidth="{TemplateBinding ActualWidth}" MaxHeight="300">
                                                                    <Border x:Name="DropDownBorder" Background="#2d2d2d" 
                                                                            BorderBrush="#555555" BorderThickness="1" CornerRadius="0,0,3,3"/>
                                                                    <ScrollViewer Margin="1" SnapsToDevicePixels="True" Background="#2d2d2d" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" Background="#2d2d2d"/>
                                                                    </ScrollViewer>
                                                                </Grid>
                                                            </Popup>
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasMultiplePackings}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ComboBox.Style>
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem">
                                            <Setter Property="Background" Value="#2d2d2d"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="Padding" Value="8,5"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ComboBoxItem">
                                                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ItemBorder" Property="Background" Value="#3d3d3d"/>
                                                                <Setter Property="Foreground" Value="#ff8c00"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="ItemBorder" Property="Background" Value="#ff8c00"/>
                                                                <Setter Property="Foreground" Value="Black"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                </ComboBox>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Qty" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                                <Button Command="{Binding DataContext.DecrementQtyCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Content="-" Background="#333333" Foreground="White" Width="24" Height="24" Margin="2" Padding="0"/>
                                
                                <TextBox Text="{Binding Qty, StringFormat='{}{0:0.###}', UpdateSourceTrigger=PropertyChanged}" 
                                         VerticalAlignment="Center" MinWidth="30" TextAlignment="Center" 
                                         HorizontalAlignment="Center" Background="Transparent" BorderThickness="0">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="CaretBrush" Value="White"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsWeightUnit}" Value="True">
                                                    <Setter Property="Foreground" Value="Cyan"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <Button Command="{Binding DataContext.IncrementQtyCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Content="+" Background="#333333" Foreground="White" Width="24" Height="24" Margin="2" Padding="0"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Price" Binding="{Binding SPrice, StringFormat='N0'}" Width="80" IsReadOnly="True" ElementStyle="{StaticResource CenteredCell}"/>
                <DataGridTextColumn Header="GST" Binding="{Binding TaxAmount, StringFormat='N0'}" Width="80" IsReadOnly="True" ElementStyle="{StaticResource CenteredCell}"/>
                <DataGridTextColumn Header="Discount" Binding="{Binding Discount, StringFormat='N0', UpdateSourceTrigger=PropertyChanged}" Width="80" IsReadOnly="False" ElementStyle="{StaticResource CenteredCell}">
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox">
                            <Setter Property="Background" Value="#333333"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="5"/>
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Width="135">
                    <DataGridTemplateColumn.Header>
                        <Grid HorizontalAlignment="Stretch">
                            <TextBlock Text="Net Amount" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Button Command="{Binding DataContext.VoidSaleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Width="20" Height="20" Cursor="Hand"
                                    Background="Transparent" BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <Ellipse x:Name="circle" Fill="#22ff5555" Width="18" Height="18"/>
                                            <TextBlock Text="✕" Foreground="#ff5555" FontSize="10" FontWeight="Bold" 
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="circle" Property="Fill" Value="#44ff5555"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Margin="5,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Text="{Binding NetAmount, StringFormat='N0'}" 
                                         Foreground="#ff8c00" FontWeight="Black" FontSize="16" 
                                         VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>

                                <Button Grid.Column="1" Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Width="24" Height="24"  Cursor="Hand"
                                        Background="Transparent" BorderThickness="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Grid>
                                                <Ellipse x:Name="circle" Fill="#33ffffff" Width="22" Height="22"/>
                                                <TextBlock Text="✕" Foreground="#ff5555" FontSize="12" FontWeight="Bold" 
                                                         HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="circle" Property="Fill" Value="#44ff4444"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
            </DataGrid.Columns>
        </DataGrid>

        <!-- Bottom Actions Bar (Checkout) -->
        <Border Grid.Row="2" Background="#252526" Padding="25,15" BorderBrush="#3d3d3d" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Dynamic Payment Method Selection -->
                <ScrollViewer Grid.Row="0" Grid.ColumnSpan="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,12"
                              Visibility="{Binding ShowPaymentCarousel, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernScrollBar}"/>
                    </ScrollViewer.Resources>
                    <ItemsControl ItemsSource="{Binding PaymentMethods}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectPaymentMethodCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Margin="0,0,12,0" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="MainBorder" 
                                                    Background="#1e1e1e" 
                                                    BorderBrush="#333333" 
                                                    BorderThickness="1.5" 
                                                    CornerRadius="10" 
                                                    Padding="15,8">
                                                <StackPanel Width="70">
                                                    <Image Source="{Binding ImagePath}" Width="38" Height="38" Stretch="Uniform" Margin="0,0,0,5">
                                                        <Image.Effect>
                                                            <DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.3"/>
                                                        </Image.Effect>
                                                    </Image>
                                                    <TextBlock Text="{Binding Method}" 
                                                             Foreground="White" 
                                                             FontSize="10" 
                                                             TextAlignment="Center" 
                                                             FontWeight="SemiBold"
                                                             TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="MainBorder" Property="BorderBrush" Value="#ff8c00"/>
                                                    <Setter TargetName="MainBorder" Property="Background" Value="#2d1d1a"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="MainBorder" Property="Background" Value="#252525"/>
                                                    <Setter TargetName="MainBorder" Property="BorderBrush" Value="#444444"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Summary stats -->
                <WrapPanel Grid.Row="1" VerticalAlignment="Center">
                    <StackPanel Margin="0,5,25,5">
                        <TextBlock Text="TOTAL ITEMS" Foreground="#666666" FontSize="9" FontWeight="Bold" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding TotalItems, StringFormat='{}{0:0.###}'}" Foreground="Cyan" FontSize="18" FontWeight="Black"/>
                    </StackPanel>

                    <!-- Total GST Removed as per request -->
                    <!-- <StackPanel Margin="0,5,25,5">
                        <TextBlock Text="TOTAL GST" Foreground="#666666" FontSize="9" FontWeight="Bold" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding TotalTax, StringFormat='N0'}" Foreground="White" FontSize="18" FontWeight="Black"/>
                    </StackPanel> -->
                    
                    <StackPanel Margin="0,5,25,5" Orientation="Horizontal">
                        <StackPanel>
                            <TextBlock Text="CASH RECEIVED" Foreground="#666666" FontSize="9" FontWeight="Bold" Margin="0,0,0,2"/>
                            <TextBox x:Name="CashReceivedBox" Text="{Binding CashReceived, UpdateSourceTrigger=PropertyChanged}" 
                                     PreviewTextInput="NumberValidationTextBox"
                                     FontSize="18" Width="100" Padding="8,4" 
                                     Foreground="White" FontWeight="Bold" BorderThickness="1" BorderBrush="#333333"
                                     VerticalContentAlignment="Center">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding PrintReceiptCommand}"/>
                                </TextBox.InputBindings>
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Background" Value="#1a1a1a"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPaymentInsufficient}" Value="True">
                                                <Setter Property="BorderBrush" Value="#ff4444"/>
                                                <Setter Property="Background" Value="#2a1a1a"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Margin="0,5,25,5">
                        <TextBlock Text="{Binding BalanceLabel}" Foreground="#666666" FontSize="9" FontWeight="Bold" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding Balance, StringFormat='N0'}" Foreground="#00ff00" FontSize="22" FontWeight="Black"/>
                        <!-- Fee breakdown for online payments -->
                        <TextBlock Margin="0,3,0,0" Foreground="#888888" FontSize="10">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOnlinePayment}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <Run Text="Online Fees: "/><Run Text="{Binding ServiceCharge, StringFormat='+{0:N0}'}" Foreground="#ff8c00"/>
                        </TextBlock>
                    </StackPanel>
                    
                    <StackPanel Margin="0,5,0,5">
                        <TextBlock Text="TOTAL AMOUNT" Foreground="#666666" FontSize="9" FontWeight="Bold" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding TotalAmount, StringFormat='N0'}" Foreground="#ff8c00" FontSize="36" FontWeight="Black" Margin="0,-4,0,0"/>
                    </StackPanel>
                </WrapPanel>

                <!-- Actions -->
                <WrapPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Command="{Binding ReturnItemsCommand}" ToolTip="Start Return Process (F7)" Width="120" Height="45" Margin="5"
                            Foreground="#ff8c00" BorderThickness="1" BorderBrush="#ff8c00" FontWeight="Bold">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE10E;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="RETURN (F7)" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1a1a1a"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Command="{Binding SelectPaymentMethodCommand}" ToolTip="Select Payment Method (F5)" Content="{Binding PaymentMethodCapitalized}" Width="100" Height="45" Margin="5"
                            Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="14">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#333333"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="5,0">
                                                <TextBlock Text="{TemplateBinding Content}" 
                                                         TextWrapping="Wrap" 
                                                         TextAlignment="Center" 
                                                         VerticalAlignment="Center" 
                                                         HorizontalAlignment="Center"
                                                         FontSize="11"
                                                         LineHeight="12"
                                                         LineStackingStrategy="BlockLineHeight"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOnlinePayment}" Value="True">
                                        <Setter Property="Background" Value="#ff4444"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.8"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Command="{Binding PrintLastReceiptCommand}" ToolTip="Print Last Receipt (F8)" Width="100" Height="45" Margin="5"
                            Foreground="Cyan" BorderThickness="1" BorderBrush="Cyan" FontWeight="Bold">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE819;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="LAST (F8)" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1a1a1a"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Command="{Binding PrintReceiptCommand}" ToolTip="Save and Print Receipt (F12)" Width="140" Height="45" Margin="5"
                            Foreground="White" BorderThickness="0" FontWeight="Bold">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="PRINT (F12)" FontSize="16" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#ff8c00"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#ffa500"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>


