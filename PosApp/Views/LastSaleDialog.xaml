<Window x:Class="PosApp.Desktop.Views.LastSaleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Last Sale Options" Height="240" Width="400"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="True" Background="Transparent"
        MouseDown="Window_MouseDown">
    <Border Background="#1e1e1e" BorderBrush="#ff8c00" BorderThickness="1.5" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/> <!-- Bottom Buttons -->
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" Margin="15,10,10,0">
                <TextBlock Text="LAST SALE OPTIONS" Foreground="#ff8c00" 
                           FontSize="16" FontWeight="Black" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <Button Content="✕" Click="Cancel_Click" 
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="30" Height="30" Foreground="#666666" Background="Transparent" BorderThickness="0"
                        FontSize="16" FontWeight="Bold" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="#ff4444"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="25,10,25,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="INVOICE NO:" Foreground="#aaaaaa" VerticalAlignment="Center" Margin="0,0,15,0" FontSize="14" FontWeight="SemiBold"/>
                <TextBox x:Name="InvoiceNoTextBox" Grid.Column="1"
                         FontSize="30" Padding="12" 
                         Background="#252525" Foreground="White" 
                         BorderBrush="#444444" BorderThickness="1"
                         KeyDown="InvoiceNoTextBox_KeyDown">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </TextBox.Resources>
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter Property="BorderBrush" Value="#ff8c00"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </Grid>

            <Grid Grid.Row="2" Margin="25,0,25,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <Button Content="CANCEL" Click="Cancel_Click" 
                        Padding="15,10" HorizontalAlignment="Left"
                        Background="Transparent" Foreground="#666666" BorderThickness="0" Cursor="Hand"/>
                
                <Button Grid.Column="1" Content="PRINT RECEIPT" Click="Print_Click" 
                        Width="130" Height="40" Margin="0,0,12,0" 
                        Background="#2d2d2d" Foreground="Cyan" BorderThickness="1.2" BorderBrush="Cyan" FontWeight="Bold" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#3d3d3d"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                
                <Button Grid.Column="2" Content="ADD TO BILL" Click="Add_Click" 
                        Width="130" Height="40" 
                        Background="#ff8c00" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#ff9d1a"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
