<Window x:Class="PosApp.Desktop.Views.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Supervisor Override" Height="220" Width="380"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        AllowsTransparency="True" WindowStyle="None" Background="Transparent"
        Topmost="True">
    <Window.Resources>
        <Storyboard x:Key="ErrorShake">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MainBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                <EasingDoubleKeyFrame KeyTime="0:0:0.0" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.05" Value="-10"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="10"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.15" Value="-10"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="10"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.25" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <Style x:Key="ModernBtn" TargetType="Button">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="MainBorder" Margin="10" Background="#1a1a1a" CornerRadius="12" BorderBrush="#ff8c00" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Direction="0" ShadowDepth="0" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        <Border.RenderTransform>
            <TranslateTransform X="0"/>
        </Border.RenderTransform>
        
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                <Path Data="M18,8H17V6A5,5 0 0,0 12,1A5,5 0 0,0 7,6V8H6A2,2 0 0,0 4,10V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V10A2,2 0 0,0 18,8M9,6A3,3 0 0,1 12,3A3,3 0 0,1 15,6V8H9V6M18,20H6V10H18V20M12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17A2,2 0 0,0 14,15A2,2 0 0,0 12,13Z" 
                      Fill="#ff8c00" Height="24" Width="24" Stretch="Uniform" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding PromptTitle}" FontSize="16" FontWeight="Bold" Foreground="#ff8c00" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Input Area -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <PasswordBox x:Name="PasswordInput" 
                             FontSize="22" Padding="10" Background="#262626" Foreground="White" 
                             BorderBrush="#444444" BorderThickness="0,0,0,2"
                             KeyDown="PasswordInput_KeyDown"
                             HorizontalContentAlignment="Center"/>
                
                <TextBlock x:Name="ErrorMessage" Foreground="#ff5555" FontSize="12" Margin="0,5,0,0"
                           HorizontalAlignment="Center" FontWeight="SemiBold" Visibility="Hidden"/>
            </StackPanel>

            <!-- Footer Buttons -->
            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Button Content="CANCEL" Click="Cancel_Click" Style="{StaticResource ModernBtn}" Margin="0,0,5,0" />
                <Button Grid.Column="1" Content="CONFIRM" Click="Confirm_Click" Style="{StaticResource ModernBtn}" 
                        Background="#ff8c00" FontWeight="Bold" Margin="5,0,0,0"/>
            </Grid>
        </Grid>
    </Border>
</Window>
