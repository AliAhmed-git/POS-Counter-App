<UserControl x:Class="PosApp.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1280">
    <UserControl.InputBindings>
        <KeyBinding Key="Esc" Command="{Binding CloseCommand}"/>
    </UserControl.InputBindings>
    
    <Grid>
        <!-- Consistent Dark Background -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0f0f0f" Offset="0"/>
                <GradientStop Color="#1a1a1a" Offset="0.5"/>
                <GradientStop Color="#0a0a0a" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Background Glows -->
        <Ellipse Width="500" Height="500" Fill="#ff8c00" Opacity="0.04" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-150,-150,0,0">
            <Ellipse.Effect>
                <BlurEffect Radius="120"/>
            </Ellipse.Effect>
        </Ellipse>

        <Border Width="500" VerticalAlignment="Center" HorizontalAlignment="Center" 
                Background="#252526" BorderBrush="#3d3d3d" BorderThickness="1" CornerRadius="20" Padding="40">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" Color="Black" ShadowDepth="0" Opacity="0.7"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="SYSTEM SETTINGS" Foreground="#ff8c00" FontSize="20" FontWeight="Black" 
                           HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="CONFIGURE YOUR POS ENVIRONMENT" Foreground="#666666" FontSize="11" FontWeight="Bold" 
                           HorizontalAlignment="Center" Margin="0,0,0,40"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="450">
                    <StackPanel>
                        <!-- Address and Phone fields removed as per user request (managed via JSON) -->
                        <StackPanel Margin="0,0,0,20"/>

                        <StackPanel Margin="0,0,0,30">
                            <TextBlock Text="Default Printer" Foreground="#aaaaaa" Margin="0,0,0,8" FontSize="12" FontWeight="SemiBold"/>
                            <ComboBox ItemsSource="{Binding InstalledPrinters}" SelectedItem="{Binding PrinterName}"
                                      Padding="12,10" Background="#1e1e1e" Foreground="White" Height="50"
                                      BorderThickness="1" BorderBrush="#333333"
                                      Style="{StaticResource DarkComboBoxStyle}">
                                <ComboBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </ComboBox.Resources>
                            </ComboBox>
                        </StackPanel>

                        <Border BorderBrush="#333333" BorderThickness="0,1,0,0" Margin="0,10,0,20"/>

                        <TextBlock Text="SYSTEM INTEGRATION" Foreground="#ff8c00" FontSize="14" FontWeight="Black" 
                                   HorizontalAlignment="Center" Margin="0,0,0,15"/>

                        <Button Command="{Binding SetupStartupCommand}" Content="SETUP FOR STARTUP" Height="45" FontSize="13"
                                Foreground="Cyan" FontWeight="Bold" Margin="0,0,0,30" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="Cyan"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1a2a2a"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <Button Command="{Binding SaveSettingsCommand}" Content="SAVE CONFIGURATION" Height="55" FontSize="16"
                        Foreground="White" FontWeight="Bold" Margin="0,10,0,0" BorderThickness="0" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="#ff8c00" Offset="0"/>
                                        <GradientStop Color="#ff6600" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="0.9"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Opacity" Value="0.8"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <TextBlock Text="{Binding StatusText}" Foreground="#00ff00" HorizontalAlignment="Center" Margin="0,20,0,0" FontSize="13" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <!-- Minimalist Back Button -->
        <Button Command="{Binding CloseCommand}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="30"
                Background="Transparent" BorderThickness="0" Cursor="Hand">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⟵" Foreground="#666666" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="BACK TO SALE" Foreground="#666666" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
            <Button.Style>
                <Style TargetType="Button">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.7"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</UserControl>
