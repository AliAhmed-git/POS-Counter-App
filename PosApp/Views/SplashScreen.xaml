<Window x:Class="PosApp.Desktop.Views.SplashScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="POS App" Height="400" Width="600"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        AllowsTransparency="True" Background="Transparent">
    <Border Background="#1e1e1e" CornerRadius="10" BorderThickness="1" BorderBrush="#ff8c00">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Splash Screen Image -->
            <Image Source="/splashscreen.png" Stretch="Uniform" Margin="20"/>

            <!-- Loading Progress -->
            <StackPanel Grid.Row="1" Margin="20,0,20,20">
                <TextBlock Text="Loading POS System..." Foreground="#ff8c00" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <ProgressBar IsIndeterminate="True" Height="4" Background="#333333" Foreground="#ff8c00"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
