<Window x:Class="PriceChecker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PriceChecker"
        mc:Ignorable="d"
        Title="Price Checker" 
        WindowState="Maximized" 
        WindowStyle="None" 
        Background="#1A1A1A"
        Topmost="True">
    
    <!-- DataContext is set in code-behind via DI -->

    <Grid>
        <!-- Background Decoration -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#000000" Offset="0"/>
                <GradientStop Color="#1A1A1A" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            
            <!-- Header -->
            <TextBlock Text="ASIF SUPER STORE" 
                       Foreground="#FF8C00" 
                       FontSize="48" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,50">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="10" Color="Black" ShadowDepth="2"/>
                </TextBlock.Effect>
            </TextBlock>

            <!-- Item Display Area -->
            <Border Background="#121212" 
                    CornerRadius="20" 
                    Padding="40" 
                    MinWidth="800" 
                    BorderBrush="#FF8C00" 
                    BorderThickness="2">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Color="#FF8C00" Opacity="0.3"/>
                </Border.Effect>
                
                <StackPanel>
                    <!-- Item Name -->
                    <TextBlock Text="{Binding ItemName}" 
                               Foreground="White" 
                               FontSize="64" 
                               TextAlignment="Center" 
                               FontWeight="Bold" 
                               TextWrapping="Wrap"
                               Margin="0,0,0,20"/>
                    
                    <!-- Packing -->
                    <TextBlock Text="{Binding Packing}" 
                               Foreground="#FFA500" 
                               FontSize="32" 
                               TextAlignment="Center" 
                               Margin="0,0,0,40"
                               Visibility="{Binding IsDataVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Visibility="{Binding IsDataVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <!-- Retail Price -->
                        <StackPanel Margin="0,0,40,0"
                                    Visibility="{Binding IsRetailVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="RETAIL PRICE" Foreground="#AAA" FontSize="20" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding RetailPrice, StringFormat='Rs {0:N0}'}" 
                                       Foreground="#FF4444" 
                                       FontSize="56" 
                                       FontWeight="Bold"
                                       TextDecorations="Strikethrough"/>
                        </StackPanel>

                        <!-- Discount Price -->
                        <StackPanel>
                            <TextBlock Text="OUR PRICE" Foreground="#FF8C00" FontSize="20" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding DiscountPrice, StringFormat='Rs {0:N0}'}" 
                                       Foreground="#FF8C00" 
                                       FontSize="72" 
                                       FontWeight="ExtraBold"/>
                            
                            <!-- Discount Badge -->
                            <Border Background="#FF4444" CornerRadius="5" Padding="10,2" Margin="0,5,0,0"
                                    HorizontalAlignment="Center"
                                    Visibility="{Binding IsRetailVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding DiscountAmount, StringFormat='SAVING Rs {0:N0}'}" 
                                           Foreground="White" FontSize="14" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Scan Prompt -->
                    <TextBlock Text="PLEASE SCAN BARCODE" 
                               Foreground="#FF8C00" 
                               FontSize="36" 
                               TextAlignment="Center" 
                               Visibility="{Binding IsDataVisible, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"
                               Margin="0,40,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                                                                 From="1.0" To="0.3" Duration="0:0:1" AutoReverse="True"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Barcode Testing -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,50,0,0">
                <TextBlock Text="TEST BARCODE:" Foreground="#666" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Text="{Binding TestBarcode, UpdateSourceTrigger=PropertyChanged}" 
                         Width="200" 
                         Background="#222" 
                         Foreground="White" 
                         BorderBrush="#444">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding RunTestBarcodeCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <Button Content="TEST" 
                        Command="{Binding RunTestBarcodeCommand}" 
                        Background="#FF8C00" 
                        Foreground="Black" 
                        FontWeight="Bold" 
                        Padding="15,5" 
                        Margin="10,0,0,0"
                        BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>

            <!-- Status Footer -->
            <Grid Margin="0,20,0,0">
                <TextBlock Text="{Binding ApiStatus}" 
                           Foreground="#666" 
                           FontSize="14" 
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"/>
                
                <TextBlock Text="{Binding StatusMessage}" 
                           Foreground="#444" 
                           FontSize="18" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"/>
            </Grid>

        </StackPanel>
    </Grid>
</Window>
