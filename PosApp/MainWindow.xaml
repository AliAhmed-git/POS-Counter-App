<Window x:Class="PosApp.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PosApp.Desktop"
        xmlns:views="clr-namespace:PosApp.Desktop.Views"
        xmlns:vm="clr-namespace:PosApp.Desktop.ViewModels"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="ASIF SUPER STORE POS" MinHeight="720" MinWidth="1024"
        Icon="/app-icon.png"
        WindowState="{Binding WindowState, Mode=TwoWay}"
        WindowStyle="{Binding WindowStyle}"
        ResizeMode="{Binding ResizeMode}"
        Topmost="{Binding IsTopmost}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
    
    <Window.Resources>
    </Window.Resources>

    <Grid Background="#1e1e1e">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header (No Sidebar) -->
        <Border Grid.Row="0" Height="60" Background="#2d2d2d" BorderBrush="#ff8c00" BorderThickness="0,0,0,2" Padding="20,0">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/app-icon.png" Width="30" Height="30" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="ASIF SUPER STORE POS" Foreground="#ff8c00" VerticalAlignment="Center" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CounterName}" Foreground="#ff8c00" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,15,0"/>
                    <TextBlock Text="{Binding UserName}" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    
                    <!-- DCR Button -->
                    <Button Command="{Binding NavigateToDCRCommand}" ToolTip="Daily Cash Report (DCR)"
                            Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" Margin="0,0,15,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Width="80" Height="36" CornerRadius="4" 
                                        Background="#1a1a1a" BorderBrush="#ff8c00" BorderThickness="1.5">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="📊" Foreground="#ff8c00" FontSize="14" Margin="0,0,6,0"/>
                                        <TextBlock Text="DCR" Foreground="White" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#2a2a2a"/>
                                        <Setter TargetName="border" Property="BorderBrush" Value="#ffa500"/>
                                        <Setter TargetName="border" Property="Cursor" Value="Hand"/>
                                        <Setter TargetName="border" Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect BlurRadius="12" Color="#ff8c00" Opacity="0.6" ShadowDepth="0"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    
                    <!-- Settings Button -->
                    <Button Command="{Binding NavigateToSettingsCommand}" ToolTip="Settings (Ctrl+S)"
                            Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" Margin="0,0,10,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Width="30" Height="30" CornerRadius="4" Background="#333333">
                                    <TextBlock Text="⚙" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#444444"/>
                                        <Setter TargetName="border" Property="BorderBrush" Value="#ff8c00"/>
                                        <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Profile Icon with Logout functionality -->
                    <Button Command="{Binding LogoutCommand}" ToolTip="Click to Logout"
                            Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Width="30" Height="30" CornerRadius="15" Background="#ff8c00">
                                    <Grid>
                                        <TextBlock x:Name="initial" Text="U" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                        <TextBlock x:Name="logoutText" Text="Logout" Foreground="White" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#ff6666"/>
                                        <Setter TargetName="initial" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="logoutText" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content (Centered/Full) -->
        <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}">
            <ContentControl.Resources>
                <DataTemplate DataType="{x:Type vm:LoginViewModel}">
                    <views:LoginView/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:SaleViewModel}">
                    <views:SaleView/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                    <views:SettingsView/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:DCRViewModel}">
                    <views:DCRView/>
                </DataTemplate>
            </ContentControl.Resources>
        </ContentControl>

        <!-- Status Bar -->
        <Border Grid.Row="2" Height="30" Background="#2d2d2d" BorderBrush="#333333" BorderThickness="0,1,0,0">
            <Border x:Name="border" Background="Transparent" Padding="15,0">
                <DockPanel LastChildFill="True">
                    <TextBlock Text="{Binding StatusText}" 
                             Foreground="#ff8c00" VerticalAlignment="Center" FontSize="11"/>
                    
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Ellipse x:Name="syncIndicator" Width="8" Height="8" Fill="{Binding SyncStatusColor}" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding SyncStatusText}" Foreground="{Binding SyncStatusColor}" VerticalAlignment="Center" FontSize="11" Margin="0,0,15,0"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
                            <TextBlock Text="🕒 " Foreground="#555555" FontSize="10"/>
                            <TextBlock Text="{Binding NextSyncIn}" Foreground="#888888" FontSize="10"/>
                        </StackPanel>

                        <TextBlock Text="Local DB: Connected" Foreground="#444444" VerticalAlignment="Center" FontSize="10"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Border>
    </Grid>
</Window>
